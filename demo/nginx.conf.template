# Serves index.html and forwards POST /v1/daylight to the API with the key.
# The official nginx image fills in ${DEMO_KEY} and ${API_URL} at startup.

# At most 20 simulations a minute per visitor, so the demo cannot crowd out
# Heath's students on the shared GPU queue.
limit_req_zone $binary_remote_addr zone=demo:1m rate=20r/m;

server {
    listen 80;
    gzip on;
    gzip_types application/json;

    location = /v1/daylight {
        limit_req zone=demo burst=5 nodelay;
        limit_req_status 429;
        limit_except POST { deny all; }
        client_max_body_size 16k;
        proxy_set_header Authorization "Bearer ${DEMO_KEY}";
        proxy_read_timeout 120s;
        proxy_pass ${API_URL};
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
