# Copy to .env (never commit .env).

# Client apps allowed to call the API: "app-id:key,app-id:key".
# Clients send "Authorization: Bearer <key>".
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
APP_KEYS=heath:change-me,mr-app:change-me

REDIS_URL=redis://redis:6379/0

# Browser origins allowed by CORS (comma-separated).
ALLOWED_ORIGINS=https://apps.ace.chalmers.se

# Worker processes. Unset = chosen from the hardware: one EnergyPlus run per
# physical core, two Foton processes per GPU. Set only to override.
# ENERGY_CONCURRENCY=8
# DAYLIGHT_CONCURRENCY=2

# Foton backend: auto (GPU if available), vulkan, or reference (CPU).
# Use vulkan on the GPU workstation so a missing GPU fails loudly.
FOTON_BACKEND=auto

# External EPSM service used for construction lookups.
EPSM_BASE_URL=https://epsm.chalmers.se

# How long finished results stay in Redis, in seconds.
RESULT_TTL_SECONDS=600
