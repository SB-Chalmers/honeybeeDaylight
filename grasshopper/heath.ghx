                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">fb44b51e-8d81-4ab9-b758-7a8d1fe0fd15</item>
                    <item name="IsAdvancedMode" type_name="gh_bool" type_code="1">false</item>
                    <item name="MarshalOutGuids" type_name="gh_bool" type_code="1">true</item>
                    <item name="Name" type_name="gh_string" type_code="10">HB Shade</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Shade</item>
                  </items>
                  <chunks count="2">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>3101</X>
                          <Y>30</Y>
                          <W>164</W>
                          <H>124</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>3208</X>
