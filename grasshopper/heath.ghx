                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">823ae25f-881c-4b19-9367-c7aef431fbcb</item>
                    <item name="IsAdvancedMode" type_name="gh_bool" type_code="1">false</item>
                    <item name="MarshalOutGuids" type_name="gh_bool" type_code="1">true</item>
                    <item name="Name" type_name="gh_string" type_code="10">HB Deconstruct Object</item>
